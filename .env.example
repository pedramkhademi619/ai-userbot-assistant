# Non-secret settings. Copy this file to `.env` and adjust as needed.
# Secrets (API keys, phone numbers, Telegram API credentials) are NOT
# stored here — the setup wizard saves them into the encrypted
# SecretsStore instead (see bot/secrets_store.py).

# OpenAI-compatible backend
BASE_URL = "https://api.gapgpt.app/v1"
MODEL = "gpt-4o-mini"

# Conversation / rate-limit tuning
MAX_HISTORY_PAIRS = 3
MAX_MESSAGE_LENGTH = 2000
MAX_OUTPUT_TOKENS = 250
REQUEST_TIMEOUT = 30

RATE_LIMIT_COUNT = 5
RATE_LIMIT_WINDOW = 60

USER_LOCK_TIMEOUT = 30

# Session file names (without extension) — change these if you run
# multiple accounts side by side.
RUBIKA_SESSION = "session"
TELEGRAM_SESSION = "telegram_user"
